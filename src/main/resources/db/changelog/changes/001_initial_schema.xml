<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="001-create-departments" author="daniar">
        <createTable tableName="t_departments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-roles" author="daniar">
        <createTable tableName="t_roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-users" author="daniar">
        <createTable tableName="t_users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="department_id" type="BIGINT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-1-create-users-roles" author="daniar">
        <createTable tableName="t_users_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ur_user" references="t_users(id)"/>
            </column>
            <column name="roles_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ur_role" references="t_roles(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-create-categories" author="daniar">
        <createTable tableName="t_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-create-tags" author="daniar">
        <createTable tableName="t_tags">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="006-create-tickets" author="daniar">
        <createTable tableName="t_tickets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="author_id" type="BIGINT">
                <constraints foreignKeyName="fk_ticket_author" references="t_users(id)"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints foreignKeyName="fk_ticket_category" references="t_categories(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-1-create-ticket-tags" author="daniar">
        <createTable tableName="t_ticket_tags">
            <column name="ticket_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_tt_ticket" references="t_tickets(id)"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_tt_tag" references="t_tags(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="007-create-comments" author="daniar">
        <createTable tableName="t_comments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="comment_text" type="TEXT"/>
            <column name="post_date" type="TIMESTAMP"/>
            <column name="author_id" type="BIGINT">
                <constraints foreignKeyName="fk_comment_author" references="t_users(id)"/>
            </column>
            <column name="ticket_id" type="BIGINT">
                <constraints foreignKeyName="fk_comment_ticket" references="t_tickets(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>